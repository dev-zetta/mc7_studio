#!/bin/sh
set -eu

APPDIR=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}

if [ "${PATH+x}" = x ]; then
    MC7_STUDIO_HOST_PATH_SET=1
    MC7_STUDIO_HOST_PATH_VALUE=$PATH
    export MC7_STUDIO_HOST_PATH_VALUE
else
    MC7_STUDIO_HOST_PATH_SET=0
    unset MC7_STUDIO_HOST_PATH_VALUE
fi
if [ "${XDG_DATA_DIRS+x}" = x ]; then
    MC7_STUDIO_HOST_XDG_DATA_DIRS_SET=1
    MC7_STUDIO_HOST_XDG_DATA_DIRS_VALUE=$XDG_DATA_DIRS
    export MC7_STUDIO_HOST_XDG_DATA_DIRS_VALUE
else
    MC7_STUDIO_HOST_XDG_DATA_DIRS_SET=0
    unset MC7_STUDIO_HOST_XDG_DATA_DIRS_VALUE
fi
if [ "${SSL_CERT_FILE+x}" = x ]; then
    MC7_STUDIO_HOST_SSL_CERT_FILE_SET=1
    MC7_STUDIO_HOST_SSL_CERT_FILE_VALUE=$SSL_CERT_FILE
    export MC7_STUDIO_HOST_SSL_CERT_FILE_VALUE
else
    MC7_STUDIO_HOST_SSL_CERT_FILE_SET=0
    unset MC7_STUDIO_HOST_SSL_CERT_FILE_VALUE
fi
if [ "${QT_PLUGIN_PATH+x}" = x ]; then
    MC7_STUDIO_HOST_QT_PLUGIN_PATH_SET=1
    MC7_STUDIO_HOST_QT_PLUGIN_PATH_VALUE=$QT_PLUGIN_PATH
    export MC7_STUDIO_HOST_QT_PLUGIN_PATH_VALUE
else
    MC7_STUDIO_HOST_QT_PLUGIN_PATH_SET=0
    unset MC7_STUDIO_HOST_QT_PLUGIN_PATH_VALUE
fi
if [ "${QML2_IMPORT_PATH+x}" = x ]; then
    MC7_STUDIO_HOST_QML2_IMPORT_PATH_SET=1
    MC7_STUDIO_HOST_QML2_IMPORT_PATH_VALUE=$QML2_IMPORT_PATH
    export MC7_STUDIO_HOST_QML2_IMPORT_PATH_VALUE
else
    MC7_STUDIO_HOST_QML2_IMPORT_PATH_SET=0
    unset MC7_STUDIO_HOST_QML2_IMPORT_PATH_VALUE
fi
export MC7_STUDIO_HOST_SSL_CERT_FILE_SET
export MC7_STUDIO_HOST_QT_PLUGIN_PATH_SET
export MC7_STUDIO_HOST_QML2_IMPORT_PATH_SET
export MC7_STUDIO_HOST_PATH_SET
export MC7_STUDIO_HOST_XDG_DATA_DIRS_SET

if [ -n "${PATH:-}" ]; then
    PATH="$APPDIR/usr/bin:$PATH"
else
    PATH="$APPDIR/usr/bin"
fi
if [ -n "${XDG_DATA_DIRS:-}" ]; then
    XDG_DATA_DIRS="$APPDIR/usr/share:$XDG_DATA_DIRS"
else
    XDG_DATA_DIRS="$APPDIR/usr/share:/usr/local/share:/usr/share"
fi

export PATH XDG_DATA_DIRS
export SSL_CERT_FILE="$APPDIR/usr/share/mc7-studio/cacert.pem"

exec "$APPDIR/usr/lib/mc7-studio/mc7-studio" "$@"
